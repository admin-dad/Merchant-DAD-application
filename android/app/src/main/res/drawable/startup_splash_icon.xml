<?xml version="1.0" encoding="utf-8"?>
<!-- Android masks the launch icon. Keep the full rectangular logo within
     the central safe circle of the 288dp splash drawable. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="288dp" android:height="288dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <size android:width="288dp" android:height="288dp" />
        </shape>
    </item>
    <item android:width="136dp" android:height="77dp" android:gravity="center">
        <bitmap android:src="@drawable/startup_logo" android:gravity="fill" android:filter="true" />
    </item>
</layer-list>
